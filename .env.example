# Порт сервера
PORT=3000
NODE_ENV=development

# Подключение к PostgreSQL из Docker Compose:
DATABASE_URL="postgres://postgres:postgrespassword@localhost:5433/course_db"

# JWT Секретные ключи (минимум 32 символа для криптостойкости)
JWT_ACCESS_SECRET="dev_access_super_secret_jwt_key_at_least_32_characters_long_for_security"
JWT_REFRESH_SECRET="dev_refresh_super_secret_jwt_key_at_least_32_characters_long_for_security"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Настройки Cookie для сессий (Secure и SameSite)
COOKIE_SECURE=false
COOKIE_SAME_SITE="strict"

# AES-256-GCM ключ для шифрования банковских карт (ровно 64 hex-символа = 32 байта)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

SMTP_PASS="your_smtp_password"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_email@gmail.com"
SMTP_FROM="CourseStore <your_email@gmail.com>"

