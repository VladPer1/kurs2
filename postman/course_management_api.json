      "name": "6. Bank Cards & AES-256 Encryption",
      "item": [
        {
          "name": "Add Card with AES-256-GCM Encryption",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Card bound successfully (201)\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.last4).to.eql(\"4242\");",
                  "    pm.expect(json.data.encrypted_payload).to.be.undefined;",
                  "    pm.collectionVariables.set(\"cardId\", json.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentAccessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_number\": \"4242424242424242\",\n  \"card_holder\": \"IVAN PETROV\",\n  \"exp_month\": 12,\n  \"exp_year\": 2028,\n  \"cvv\": \"123\",\n  \"is_default\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/cards", "host": ["{{baseUrl}}"], "path": ["cards"] }
          }
        },
        {
          "name": "List Saved Cards (Safe View)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}/cards", "host": ["{{baseUrl}}"], "path": ["cards"] }
          }
        }
      ]
    },
