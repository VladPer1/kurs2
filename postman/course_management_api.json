    {
      "name": "5. Enrollments (Course Bookings)",
      "item": [
        {
          "name": "Enroll in Course (Student)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Enrollment response 201 or 409\", function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.id) {",
                  "        pm.collectionVariables.set(\"enrollmentId\", json.data.id);",
                  "    } else if (json.error && json.error.enrollmentId) {",
                  "        pm.collectionVariables.set(\"enrollmentId\", json.error.enrollmentId);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentAccessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": \"{{courseId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/enrollments", "host": ["{{baseUrl}}"], "path": ["enrollments"] }
          }
        },
        {
          "name": "Get My Enrollments (Student)",
          "request": {
